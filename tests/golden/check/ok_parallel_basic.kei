module check.parallel_basic

// M47 / #161: 並行結合子 `parallel(xs) -> List<T>`。同種 List を並行実行する
// 最小形(🤝(d))。xs は list literal で、各要素は `uses Async` 関数への直接呼び出し。

func fetchName(id: Int) -> String
  uses Async
{
  return "user"
}

func greetAll(a: Int, b: Int, c: Int) -> List<String>
  uses Async
{
  return parallel([fetchName(a), fetchName(b), fetchName(c)])
}
